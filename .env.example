DATABASE_URL="postgresql://takwria:takwria@localhost:5432/takwria_dev"
DATABASE_URL_TEST="postgresql://takwria:takwria@localhost:5433/takwria_test"

# Secret de signature des sessions NextAuth.
# En production, générez-en un vrai : `openssl rand -base64 32`.
# L'application REFUSE de démarrer en production avec la valeur ci-dessous.
NEXTAUTH_SECRET="change-me-in-dev"

NEXTAUTH_URL="http://localhost:3000"

# Fuseau horaire — la génération des créneaux suppose l'heure locale
# Africa/Tunis. En développement, l'heure système de la machine suffit
# généralement ; en production, définissez-le explicitement au niveau du
# processus (pas seulement ici — Node lit TZ au démarrage, avant dotenv).
TZ="Africa/Tunis"

# Envoi des e-mails de réinitialisation de mot de passe (Resend).
# Laissez vide en développement : les liens s'affichent dans la console.
# Obligatoire en production — l'application refuse d'envoyer les liens sans
# ça (voir src/lib/mailer.ts) plutôt que de les journaliser.
RESEND_API_KEY=""
# Optionnel — expéditeur affiché. Par défaut : onboarding@resend.dev (le
# domaine de test fourni par Resend). Pour un domaine personnalisé, vérifiez
# d'abord le domaine dans le tableau de bord Resend.
EMAIL_FROM="Takwria TN <onboarding@resend.dev>"
